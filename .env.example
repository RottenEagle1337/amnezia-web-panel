# PBKDF2 hash of the panel password (required). Created by install.sh,
# or manually: printf '%s' 'PASSWORD' | docker run --rm -i amnezia-web-panel:latest python -m app.passhash
# NOTE: in .env the $ character must be escaped as $$ (docker compose requirement).
PANEL_PASSWORD_HASH=pbkdf2$$600000$$<salt_hex>$$<hash_hex>

# Public server address embedded into client configs (required)
AWG_ENDPOINT_HOST=your.server.ip.or.domain

# AWG port (as in your Amnezia setup)
AWG_ENDPOINT_PORT=51820

# Panel port on the host (default 8080)
PANEL_PORT=8080

# Bind address (default 0.0.0.0 — all interfaces, for LAN;
# use 127.0.0.1 on a public VPS together with an SSH tunnel)
PANEL_BIND=0.0.0.0
